{
  "manifest_version": 3,
  "name": "Cipher AI - Navigate the world of online shopping.",
  "version": "1.0.4",
  "description": "Displays additional info that tells you about the companies you are buying from on Amazon. Displays product page directly.",
  
  "permissions": [
    "activeTab",
    "storage"
  ],
  
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "https://wintercoder1.github.io/*",
    "https://compass-ai-internal-api.com/*",
    "http://localhost:8000/getPoliticalLeaning"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*/dp/*",
        "*://*.amazon.com/gp/product/*",
        "*://*.amazon.co.uk/*/dp/*",
        "*://*.amazon.co.uk/gp/product/*",
        "*://*.amazon.ca/*/dp/*",
        "*://*.amazon.ca/gp/product/*"
      ],
      "js": ["React/react.js", "React/react-dom.js", "Util/ChromeGlobalVariablesAndMethods.js", "Util/ChromeRuntimeMessageListeners.js", "Util/OverlayPopupManager.js",  "Components/TiltAIHeader.js", "Components/CipherAIComponent.js", "Components/CipherAIWithPaygateComponent.js", "PageParsers/typicalProductPageParser.js", "PageParsers/bookPageParser.js", "ComponentInsertionManager.js", "NetworkManager.js", "DisplayElementManager.js", "PayGate/RateLimitManager.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cipher AI Settings"
  },
  "web_accessible_resources": [
    {
      "resources": ["Components/tilt-ai-styles.css", "icons/*", "PageParsers/*", "React/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/cipher_logo@16.png",
    "32": "icons/cipher_logo@32.png",
    "48": "icons/cipher_logo@48.png",
    "128": "icons/cipher_logo@128.png"
  }
}